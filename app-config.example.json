{
  "env_variables": {
    "CATALYST_APP_JWT_SECRET": "your-jwt-secret-here",
    "CATALYST_TENANT_PROVISIONING_KEY": "your-tenant-provisioning-key-here",
    "CATALYST_DB_URL": "jdbc:postgresql://your-db-host:5432/your-db-name?sslmode=require",
    "CATALYST_DB_USERNAME": "your-db-username",
    "CATALYST_DB_PASSWORD": "your-db-password",
