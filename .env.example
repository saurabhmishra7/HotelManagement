# Template only; Spring does not automatically load .env. Set real env vars in Catalyst.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://db.example.com:5432/innovaserve?sslmode=verify-full
DB_USERNAME=innovaserve
DB_PASSWORD=
JWT_SECRET=
PLATFORM_JWT_SECRET=
APP_ALLOWED_ORIGINS=https://staff.example.com,https://guest.example.com
PLATFORM_ALLOWED_ORIGINS=https://platform.example.com
APP_SIGNUP_VERIFICATION_BASE_URL=https://staff.example.com/
APP_PASSWORD_RESET_BASE_URL=https://staff.example.com/
APP_STAFF_INVITATION_BASE_URL=https://staff.example.com/invite
APP_STAFF_APPROVAL_BASE_URL=https://staff.example.com/
APP_EMAIL_VERIFICATION_BASE_URL=https://staff.example.com/
APP_MAIL_PROVIDER=resend
APP_MAIL_FROM=InnovaServe <hello@example.com>
APP_MAIL_RESEND_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TENANT_PROVISIONING_KEY=
RECEIPT_STORAGE_DIR=/data/expense-receipts
DB_POOL_SIZE=10
# Catalyst supplies X_ZOHO_CATALYST_LISTEN_PORT. Never enable demo payment in prod.

# SMTP alternative (instead of Resend):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
